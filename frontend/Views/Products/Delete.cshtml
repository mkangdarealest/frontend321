@model frontend.Models.Product

@{
    ViewBag.Title = "Admin: Delete Product";

    // --- Image Logic ---
    var image = Model.ProductImages.FirstOrDefault(img => img.IsPrimary) ?? Model.ProductImages.FirstOrDefault();
    string imageUrl = (image != null) ? image.Url : "~/hinh/VitaminC.jpg"; // Placeholder
}

@* 1. ADD THIS CSS STYLE BLOCK *@
<style>
    .delete-container {
        max-width: 600px;
        margin: 20px auto;
        padding: 20px;
        background: #fff;
        border: 1px solid #d9534f; /* Red border for warning */
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .delete-summary-card {
        display: flex;
        gap: 15px;
        align-items: center;
        padding: 15px;
        background: #fefafa;
        border: 1px solid #fbebeb;
        border-radius: 4px;
        margin-top: 15px;
    }

    .delete-summary-image img {
        width: 100px;
        height: 100px;
        object-fit: cover;
        border-radius: 4px;
    }

    .delete-summary-info h4 {
        margin: 0 0 5px 0;
        font-size: 1.25rem;
    }

    .delete-summary-info span {
        display: block;
        color: #555;
    }
</style>

@* 2. THIS IS THE NEW HTML LAYOUT *@
<div class="delete-container">
    <h3>Are you sure you want to delete this product?</h3>
    <p>This action cannot be undone. Please review the details below.</p>

    <div class="delete-summary-card">
        <div class="delete-summary-image">
            <img src="@Url.Content(imageUrl)" alt="@Model.Name" />
        </div>
        <div class="delete-summary-info">
            <h4>@Html.DisplayFor(model => model.Name)</h4>
            <span><strong>Brand:</strong> @Html.DisplayFor(model => model.Brand)</span>
            <span style="font-weight: bold; color: #007bff;">
                <strong>Price:</strong> @Html.DisplayFor(model => model.Price)đ
            </span>
        </div>
    </div>

    @* This is the form that performs the delete action *@
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color" style="margin-top: 20px;">
            <input type="submit" value="Delete" class="btn btn-danger" /> |
            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-default" })
        </div>
    }
</div>