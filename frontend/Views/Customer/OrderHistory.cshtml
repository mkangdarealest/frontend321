@model IEnumerable<frontend.Models.Order>
@{
    ViewBag.Title = "Lịch sử giao dịch";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/css/GioHang.css" rel="stylesheet" />

<div class="container_1">
    <h1>@ViewBag.Title</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="background-color: #e6f7ec; border: 1px solid #00b33c; padding: 15px; border-radius: 8px; margin-bottom: 20px; color: #00521b;">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="cart-items">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <h2>Bạn chưa có đơn hàng nào.</h2>
                @Html.ActionLink("Bắt đầu mua sắm", "LongChauClone", "TrangChu", null, new { @class = "cta-shopping" })
            </div>
        }
        else
        {
            <table class="cart-table">
                <thead>
                    <tr>
                        <th>Mã đơn hàng</th>
                        <th>Ngày đặt</th>
                        <th>Trạng thái</th>
                        <th>Tổng tiền</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>#@order.Id</td>
                            <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@order.OrderStatu.Name</td>
                            <td>@order.Total.ToString("N0") đ</td>
                            <td>
                                @Html.ActionLink("Xem chi tiết", "OrderDetails", new { id = order.Id }, new { @class = "btn btn-info" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>