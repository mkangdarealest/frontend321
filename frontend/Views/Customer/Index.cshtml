@model frontend.Models.Customer
@{
    ViewBag.Title = "Thông tin tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/css/register.css" rel="stylesheet" type="text/css" />

<div class="register-container"style="padding-top: 65px; padding-bottom: 20px;">
    <h2>@ViewBag.Title</h2>
    <p>Chỉnh sửa thông tin cá nhân của bạn.</p>

    @using (Html.BeginForm("Index", "Customer", FormMethod.Post, new { role = "form" }))
    {
        @Html.AntiForgeryToken()

        <div class="register-form">
            @Html.ValidationSummary("", new { @class = "text-danger" })

            @* We add this to make sure we update the correct user *@
            @Html.HiddenFor(m => m.Id)
            @Html.HiddenFor(m => m.UserName)
            @Html.HiddenFor(m => m.Password)
            @Html.HiddenFor(m => m.CreatedAt)

            <div class="form-group">
                @Html.LabelFor(m => m.UserName, "Tên đăng nhập")
                @* We make the username read-only so they can't change it *@
                @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", @readonly = "readonly" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.FirstName, "Họ")
                @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.LastName, "Tên *")
                @Html.TextBoxFor(m => m.LastName, new { @class = "form-control" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Email, "Email *")
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Phone, "Số điện thoại")
                @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.AddressLine, "Địa chỉ")
                @Html.TextBoxFor(m => m.AddressLine, new { @class = "form-control" })
            </div>

            <div class="form-group">
                <input type="submit" value="Lưu thay đổi" class="btn btn-primary" />
            </div>
        </div>
    }
</div>