
@{
    ViewBag.Title = "VitaminC";
    Layout = "~/Views/SanPhamNoiBat/VitaminC.cshtml";
}

@{
    Layout = null;
    var productName = "Viên uống Vitamin C 500mg";
    var brand = "HealthPlus";
    var price = 120000;
    var originalPrice = 150000;
    var rating = 4.8;
    var reviews = 42;
    var description = "Viên uống Vitamin C giúp tăng cường sức đề kháng, làm sáng da và chống oxy hóa.";
    var ingredients = "Vitamin C 500mg, Bioflavonoids, Rosehip Extract";
    var usage = "Uống 1 viên mỗi ngày sau bữa ăn.";
    var origin = "Mỹ";
    var packaging = "Hộp 60 viên";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@productName</title>
    <link rel="stylesheet" href="~/css/SanPham/detailed_product.css" />
</head>
<body>
    @Html.Partial("_Header")
    <div class="product-container">
        <div class="product-image">
            <img src="/hinh/VitaminC.jpg" alt="@productName" />
        </div>
        <div class="product-info">
            <h1>@productName</h1>
            <p class="brand">Thương hiệu: <strong>@brand</strong></p>
            <div class="price">
                <span class="current">@price.ToString("N0")₫</span>
                <span class="original">@originalPrice.ToString("N0")₫</span>
            </div>
            <div class="rating">
                ⭐ @rating / 5.0 - @reviews đánh giá
            </div>
            <p class="description">@description</p>

            <table class="details">
                <tr><td><strong>Thành phần:</strong></td><td>@ingredients</td></tr>
                <tr><td><strong>Cách dùng:</strong></td><td>@usage</td></tr>
                <tr><td><strong>Xuất xứ:</strong></td><td>@origin</td></tr>
                <tr><td><strong>Quy cách:</strong></td><td>@packaging</td></tr>
            </table>

            <button class="buy-button">Mua ngay</button>
        </div>
    </div>
    @Html.Partial("_Footer")
</body>
</html>


