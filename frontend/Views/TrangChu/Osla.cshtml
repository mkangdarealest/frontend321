
@{
    ViewBag.Title = "Osla";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    var productName = "Thuốc nhỏ mắt Osla";
    var brand = "Merap Group";
    var price = 24000;
    var originalPrice = 30000;
    var rating = 4.5;
    var reviews = 50;
    var description = "Dung dịch nhỏ mắt đẳng trương, ổn định và vô khuẩn. Hỗ trợ giảm các triệu chứng mỏi mắt, ngứa mắt, khô rát mắt, cay mắt, xốn (cộm) mắt, đỏ mắt, mờ mắt. Giúp loại bỏ bụi bẩn, làm sạch ghèn rỉ mắt và phòng ngừa các bệnh đau mắt.";
    var ingredients = "Natri clorid 0,033g, Borneol, Benzalkonium clorid, Acid boric, Natri borat, Nước cất vừa đủ 15ml.";
    var usage = "Người lớn và trẻ em: Nhỏ 2 - 4 giọt mỗi mắt/lần x 4 - 6 lần/ngày. Có thể nhỏ nhiều lần hơn nếu cần. Sử dụng trong vòng 30 ngày sau khi đã mở nắp lần đầu.";
    var origin = "Việt Nam";
    var packaging = "Chai 15ml dung dịch nhỏ mắt.";
}


<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@productName</title>
    <link rel="stylesheet" href="~/css/SanPham/detailed_product.css" />
</head>
<body>
    <div class="product-container">
        <div class="product-image">
            <img src="~/hinh/Osla.jpg" alt="@productName" />
        </div>
        <div class="product-info">
            <h1>@productName</h1>
            <p class="brand">Thương hiệu: <strong>@brand</strong></p>
            <div class="price">
                <span class="current">@price.ToString("N0")₫</span>
                <span class="original">@originalPrice.ToString("N0")₫</span>
            </div>
            <div class="rating">
                ⭐ @rating / 5.0 - @reviews đánh giá
            </div>
            <p class="description">@description</p>

            <table class="details">
                <tr><td><strong>Thành phần:</strong></td><td>@ingredients</td></tr>
                <tr><td><strong>Cách dùng:</strong></td><td>@usage</td></tr>
                <tr><td><strong>Xuất xứ:</strong></td><td>@origin</td></tr>
                <tr><td><strong>Quy cách:</strong></td><td>@packaging</td></tr>
            </table>

            <button class="buy-button">Mua ngay</button>
        </div>
    </div>
</body>
</html>

