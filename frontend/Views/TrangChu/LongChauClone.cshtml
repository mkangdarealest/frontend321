<section class="lc-products container" style="margin-top: 30px; margin-bottom: 40px;">
    <div class="section-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
        <h2 style="color: #333; font-weight: 700;">Tất cả sản phẩm</h2>
        <a href="@Url.Action("AllProducts", "TrangChu")" class="btn btn-outline-primary btn-sm" style="border-radius: 20px;">
