@model IEnumerable<frontend.Models.Product>
@{
    ViewBag.Title = "Long Châu Clone";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/css/LongChauClone.css" rel="stylesheet" type="text/css" />
<script src="~/js/LongChauClone.js"></script>
@* --- BANNER SLIDER TRONG SUỐT (PHIÊN BẢN MỚI) --- *@

<div id="topSlider" class="top-transparent-banner container">

    <div class="top-slider-item active">
        <a href="#link-banner-1">
            <img src="~/hinh/666.png" alt="Banner 1" />
        </a>
    </div>

    <div class="top-slider-item">
        <a href="#link-banner-2">
            <img src="~/hinh/777.png" alt="Banner 2" />
        </a>
    </div>

    <div class="top-slider-item">
        <a href="#link-banner-3">
            <img src="~/hinh/888.png" alt="Banner 3" />
        </a>
    </div>

    <button class="top-slider-arrow prev" id="topSliderPrev">&lt;</button>
    <button class="top-slider-arrow next" id="topSliderNext">&gt;</button>

</div>
@* --- HẾT BANNER SLIDER TRONG SUỐT --- *@@* --- BANNER SCRIPT --- *@
<script>
    document.addEventListener("DOMContentLoaded", function () {
        banner(); // Hàm này nằm trong LongChauClone.js, giữ nguyên để chạy slider
    });
</script>

@* --- BANNER SECTION (ĐÃ SỬA) --- *@
<section class="lc-categories_banner">
    <div class="lc-categories_banner container_1">

        @* Wrapper mới để chia cột *@
        <div class="lc-banner-layout">

            @* CỘT TRÁI: SLIDER (Chuyển động) *@
            <div class="lc-banner-left">
                <div class="lc-banner-slider">
                    <img src="~/hinh/111.jpg" alt="Banner Slider 1" class="active" />
                    <img src="~/hinh/222.png" alt="Banner Slider 2" />
                    <img src="~/hinh/333.jpg" alt="Banner Slider 3" />
                    @* Bạn có thể thêm hình slider thứ 3 vào đây nếu muốn *@

                    <div class="lc-banner-dots">
                        <span class="dot active"></span>
                        <span class="dot"></span>
                        <span class="dot"></span>
                    </div>
                </div>
            </div>

            @* CỘT PHẢI: BANNER TĨNH (2 hình nhỏ) *@
            <div class="lc-banner-right">
                <div class="lc-banner-static-item">
                    @* Sửa đường dẫn hình ảnh tĩnh số 1 tại đây *@
                    <a href="#"><img src="~/hinh/444.png" alt="Banner Static 1" /></a>
                </div>
                <div class="lc-banner-static-item">
                    @* Sửa đường dẫn hình ảnh tĩnh số 2 tại đây (Ví dụ: Banner_4.png) *@
                    <a href="#"><img src="~/hinh/555.jpg" alt="Banner Static 2" /></a>
                </div>
            </div>

        </div>
    </div>
</section>

<div class="background-image"></div>

@{ Html.RenderAction("CategoryNavigation", "TrangChu"); }

<section class="lc-products container">
    <h2>Tất cả sản phẩm</h2>
    <div class="lc-product-list">
        @foreach (var product in Model)
        {
            var image = product.ProductImages.FirstOrDefault(img => img.IsPrimary);

            // If no image is marked "Primary", just get the first one in the list
            if (image == null)
            {
                image = product.ProductImages.FirstOrDefault();
            }

            // If the product has an image, use its URL. Otherwise, use a placeholder.
            string imageUrl = (image != null) ? image.Url : "~/hinh/VitaminC.jpg";

            // Slug logic and Card
            <div class="lc-product-card">
                <a href="@Url.Action("ViewProduct", "TrangChu", new { slug = product.Slug })">
                    <div class="lc-product-image-container">
                        <img src="@Url.Content(imageUrl)" alt="@product.Name" />
                    </div>
                </a>

                <h3>@product.Name</h3>

                @* Added a check in case Price is null *@
                <p class="price">@(product.Price.HasValue ? product.Price.Value.ToString("N0") + "đ" : "Liên hệ")</p>

                @using (Html.BeginForm("AddToCart", "GioHang", FormMethod.Post))
                {
                    @Html.Hidden("productId", product.Id)
                    @Html.Hidden("quantity", 1)

                    <button type="submit" class="btn btn-primary btn-buy">
                        Mua hàng
                    </button>
                }
            </div>
        }
    </div>
</section>

@* --- MOBILE MENU SCRIPT --- *@
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const toggleBtn = document.getElementById('mobileMenuToggle');
        const closeBtn = document.getElementById('mobileMenuClose');
        const overlay = document.getElementById('mobileMenuOverlay');
        const drawer = document.getElementById('mobileMenuDrawer');
        const body = document.body;

        function openMenu() {
            drawer.classList.add('is-open');
            overlay.classList.add('is-open');
            body.style.overflow = 'hidden';
        }

        function closeMenu() {
            drawer.classList.remove('is-open');
            overlay.classList.remove('is-open');
            body.style.overflow = '';
        }
        if (toggleBtn) {
            toggleBtn.addEventListener('click', openMenu);
        }
        if (closeBtn) {
            closeBtn.addEventListener('click', closeMenu);
        }
        if (overlay) {
            overlay.addEventListener('click', closeMenu);
        }
    });
</script>
@* --- SCRIPT CHO HEADER CO RÚT KHI CUỘN --- *@
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const headerTop = document.querySelector('.lc-header-top.container');

        if (headerTop) {
            window.addEventListener('scroll', function () {
                // Thêm class 'scrolled' nếu cuộn xuống hơn 50px
                if (window.scrollY > 50) {
                    headerTop.classList.add('scrolled');
                } else {
                    headerTop.classList.remove('scrolled');
                }
            });
        }
    });
</script>

@* --- MOBILE MENU SCRIPT (ĐÃ CÓ SẴN CỦA BẠN) --- *@
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // ... (giữ nguyên code mobile menu của bạn) ...
    });
</script>
@* --- SCRIPT CHO TOP SLIDER (MŨI TÊN) --- *@
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const topSlider = document.getElementById('topSlider');

        // Chỉ chạy script nếu slider này tồn tại
        if (topSlider) {
            const prevBtn = document.getElementById('topSliderPrev');
            const nextBtn = document.getElementById('topSliderNext');
            const slides = topSlider.querySelectorAll('.top-slider-item');
            let currentSlide = 0; // Bắt đầu từ slide 0 (slide có class 'active')

            function showSlide(index) {
                // Ẩn slide hiện tại
                slides[currentSlide].classList.remove('active');

                // Cập nhật slide index mới
                currentSlide = index;

                // Xử lý vòng lặp (nếu đến cuối thì quay về đầu)
                if (currentSlide >= slides.length) {
                    currentSlide = 0;
                }
                // Xử lý vòng lặp (nếu lùi ở đầu thì về cuối)
                else if (currentSlide < 0) {
                    currentSlide = slides.length - 1;
                }

                // Hiện slide mới
                slides[currentSlide].classList.add('active');
            }

            // Gán sự kiện click cho 2 nút
            nextBtn.addEventListener('click', function () {
                showSlide(currentSlide + 1);
            });

            prevBtn.addEventListener('click', function () {
                showSlide(currentSlide - 1);
            });
            setInterval(function () {
                showSlide(currentSlide + 1);
            }, 5000);
        }
    });
</script>