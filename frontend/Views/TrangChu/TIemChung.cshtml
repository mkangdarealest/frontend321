<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mùa này cần tiêm gì?</title>
    <link rel="stylesheet" href="~/css/styles.css"> <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body>

    <div class="vaccine-container">
        <h1>Mùa này cần <span class="highlight">tiêm gì?</span> 💉</h1>

        <nav class="tab-nav">
            @foreach (var category in categories)
            {
                <a href="#" class="tab-link @(category.IsActive ? "active" : "")" data-tab="@category.Id">
                    @category.TabName
                </a>
            }
        </nav>

        <div class="tab-content">
            @foreach (var category in categories)
            {
                <div class="tab-pane @(category.IsActive ? "active" : "")" id="@category.Id">
                    <div class="info-panel">
                        <div class="info-icon">@category.Icon</div>
                        <h2 class="info-title">@category.Title</h2>
                        <p class="info-description">@category.Description</p>
                        
                        <ul class="info-list">
                            @foreach (var point in category.InfoPoints)
                            {
                                <li>
                                    <span class="info-list-icon">@point.Icon</span>
                                    <span>@point.Text</span>
                                </li>
                            }
                        </ul>

                        @if (!string.IsNullOrEmpty(category.Recommendation))
                        {
                            <p class="info-recommendation">
                                <span class="info-list-icon">✍️</span>
                                <span>@category.Recommendation</span>
                            </p>
                        }
                    </div>

                    <div class="product-panel">
                        <div class="product-container" style="--product-count: @category.Products.Count">
                            @foreach (var product in category.Products)
                            {
                                <div class="product-card">
                                    @if (product.Discount != null)
                                    {
                                        <span class="product-discount">@product.Discount</span>
                                    }
                                    <img class="product-flag" src="https://flagcdn.com/w40/@(product.CountryCode).png" alt="Cờ @product.CountryCode">
                                    
                                    <img class="product-image" src="@product.ImageUrl" alt="@product.Name">
                                    
                                    <h3 class="product-name">@product.Name</h3>
                                    <p class="product-desc">@product.Description</p>
                                    <p class="product-price">
                                        @product.Price <span>/ Liều</span>
                                    </p>
                                    <button class="btn-book">Đặt hẹn</button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const tabLinks = document.querySelectorAll('.tab-link');
            const tabPanes = document.querySelectorAll('.tab-pane');

            tabLinks.forEach(link => {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    const tabId = this.getAttribute('data-tab');
                    tabLinks.forEach(l => l.classList.remove('active'));
                    tabPanes.forEach(p => p.classList.remove('active'));
                    this.classList.add('active');
                    document.getElementById(tabId).classList.add('active');
                });
            });
        });
    </script>

</body>
</html>


@functions {
    public class VaccineCategory
    {
        public string Id { get; set; }
        public string TabName { get; set; }
        public bool IsActive { get; set; } = false;
        public string Icon { get; set; }
        public string Title { get; set; }
        public string Description { get; set; }
        public List<InfoPoint> InfoPoints { get; set; } = new List<InfoPoint>();
        public string Recommendation { get; set; }
        public List<VaccineProduct> Products { get; set; } = new List<VaccineProduct>();
    }

    public class InfoPoint
    {
        public string Icon { get; set; }
        public string Text { get; set; }
    }

    public class VaccineProduct
    {
        public string Name { get; set; }
        public string Description { get; set; }
        public string Price { get; set; }
        public string CountryCode { get; set; } 
        public string ImageUrl { get; set; } = "https://via.placeholder.com/200x200.png?text=Vaccine"; 
        public string Discount { get; set; } 
    }
}