@using PagedList.Mvc;
@model PagedList.IPagedList<frontend.Models.Product>

@{
    ViewBag.Title = "Danh mục: " + ViewBag.CategoryName;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    h2 {
        padding-top: 80px;
        padding-bottom: 20px;
    }
</style>
<div class="container" style="padding-top: 20px;">
    <h2>Danh mục: @ViewBag.CategoryName</h2>
    <hr />
    @using (Html.BeginForm("ProductsByCategory", "TrangChu", FormMethod.Get, new { @class = "form-inline" }))
    {
        @Html.Hidden("slug", (string)ViewBag.CurrentSlug)

        <div class="form-group">
            <input type="text" name="searchString" class="form-control" value="@ViewBag.CurrentFilter" placeholder="Tìm sản phẩm trong danh mục này...." />
        </div>
        <button type="submit" class="btn btn-default">Tìm</button>
    }
    <div class="sorting-bar" style="margin-top: 15px; margin-bottom: 15px;">
        <strong>Sort by: </strong>

        @* Default (Name) *@
        @Html.ActionLink(
            "Name",
            "ProductsByCategory",
            new
                {
                slug = (string)ViewBag.CurrentSlug,
                searchString = ViewBag.CurrentFilter,
                sortBy = "name" // or null
            },
            new { @class = (ViewBag.CurrentSort == null || ViewBag.CurrentSort == "name") ? "btn btn-primary" : "btn btn-default" }
        )

        @* Price: Low to High *@
        @Html.ActionLink(
            "Price: Low to High",
            "ProductsByCategory",
            new
                {
                slug = (string)ViewBag.CurrentSlug,
                searchString = ViewBag.CurrentFilter,
                sortBy = "price_asc"
            },
            new { @class = (ViewBag.CurrentSort == "price_asc") ? "btn btn-primary" : "btn btn-default" }
        )

        @* Price: High to Low *@
        @Html.ActionLink(
            "Price: High to Low",
            "ProductsByCategory",
            new
                {
                slug = (string)ViewBag.CurrentSlug,
                searchString = ViewBag.CurrentFilter,
                sortBy = "price_desc"
            },
            new { @class = (ViewBag.CurrentSort == "price_desc") ? "btn btn-primary" : "btn btn-default" }
        )
    </div>
    @if (!Model.Any())
    {
        <p>Không có sản phẩm nào trong danh mục này.</p>
    }
    else
    {
        <div class="lc-product-list_all">

            @foreach (var product in Model)
            {
                var image = product.ProductImages.FirstOrDefault(img => img.IsPrimary) ?? product.ProductImages.FirstOrDefault();
                string imageUrl = (image != null) ? image.Url : "~/hinh/VitaminC.jpg";

                <div class="lc-product-card" style="text-decoration: none;">
                    <a href="@Url.Action("ViewProduct", "TrangChu", new { slug = product.Slug })">
                        <div class="lc-product-image-container">
                            <img src="@Url.Content(imageUrl)" alt="@product.Name" />
                        </div>
                    </a>
                    <h3>@product.Name</h3>
                    <p class="price">@(product.Price.HasValue ? product.Price.Value.ToString("N0") + "đ" : "")</p>
                    @Html.ActionLink("Chọn mua", "AddToCart", "ShoppingCart", new { id = product.Id }, new { @class = "btn-buy", style = "text-decoration:none" })

                </div>
            }
        </div>
    }

    <br />

    <div class="pager-container" style="text-align: center;">
        Trang @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) / @Model.PageCount
        @Html.PagedListPager(Model, page => Url.Action("ProductsByCategory",
     new { slug = (string)ViewBag.CurrentSlug, page, searchString = ViewBag.CurrentFilter, sortBy = ViewBag.CurrentSort }))
    </div>
</div>