
@{
    ViewBag.Title = "SucKhoeTimMach";
    Layout = "~/Views/DanhMucNoiBat/SucKhoeTimMach.cshtml";
}

@Html.Partial("_Header")
<section class="lc-products container">
    <h2>Sức Khỏe Tim Mạch</h2>
    <div class="lc-product-list_all">
        <div class="lc-product-card">
            <a href="https://localhost:44333/TrangChu/Magnesium">
                <div class="lc-product-image-container">
                    <img src="~/hinh/Magnesium.jpg" alt="Magnesium Complex" />
                </div>
            </a>
            <h3>Magnesium Complex</h3>
            <p class="price">195.000đ</p>
            <button class="btn-buy">Chọn mua</button>
        </div>
        <div class="lc-product-card">
            <a href="https://localhost:44333/TrangChu/Omega3">
                <div class="lc-product-image-container">
                    <img src="~/hinh/Omega3.png" alt="Omega 3 1000mg" />
                </div>
            </a>
            <h3>Omega 3 1000mg</h3>
            <p class="price">210.000đ</p>
            <button class="btn-buy">Chọn mua</button>
        </div>
        <div class="lc-product-card">
            <a href="https://localhost:44333/TrangChu/CoenzymeQ10">
                <div class="lc-product-image-container">
                    <img src="~/hinh/CoQ10.jpg" alt="Coenzyme Q10" />
                </div>
            </a>
            <h3>Coenzyme Q10</h3>
            <p class="price">350.000đ</p>
            <button class="btn-buy">Chọn mua</button>
        </div>
    </div>
</section>
@Html.Partial("_Footer")
