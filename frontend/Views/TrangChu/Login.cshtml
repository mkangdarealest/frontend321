@model frontend.Models.Customer
@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/css/Login.css" rel="stylesheet" type="text/css" />

<div class="login-container"style="padding-top: 65px; padding-bottom: 20px;">
    <h2>@ViewBag.Title</h2>

    @using (Html.BeginForm("Login", "TrangChu", FormMethod.Post, new { role = "form" }))
    {
        @Html.AntiForgeryToken()

        <div class="login-form">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                @Html.LabelFor(m => m.UserName, "Tên đăng nhập")
                @Html.TextBoxFor(m => m.UserName, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Password)
                @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <input type="submit" value="Đăng nhập" class="btn btn-primary" />
            </div>

            <p>
                Chưa có tài khoản? @Html.ActionLink("Đăng ký ngay", "Register")
            </p>
        </div>
    }
</div>