
@{
    ViewBag.Title = "HoTroLamDep";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .container {
        max-width: 1200px;
        margin: 90px auto;
    }
</style>
<section class="lc-products container">
    <h2>Hỗ Trợ Làm Đẹp</h2>
    <div class="lc-product-list_all">
        <div class="lc-product-card">
            <a href="https://localhost:44333/TrangChu/Collagen">
                <div class="lc-product-image-container">
                    <img src="~/hinh/Collagen.jpg" alt="Collagen Thủy Phân" />
                </div>
            </a>
            <h3>Collagen Thủy Phân</h3>
            <p class="price">500.000đ</p>
            <button class="btn-buy">Chọn mua</button>
        </div>
        <div class="lc-product-card">
            <a href="https://localhost:44333/TrangChu/Biotin">
                <div class="lc-product-image-container">
                    <img src="~/hinh/Biotin.jpg" alt="Biotin Max" />
                </div>
            </a>
            <h3>Biotin Max</h3>
            <p class="price">180.000đ</p>
            <button class="btn-buy">Chọn mua</button>
        </div>
        <div class="lc-product-card">
            <a href="https://localhost:44333/TrangChu/NMNPremium21600">
                <div class="lc-product-image-container">
                    <img src="~/hinh/NMNPremium21600.jpg" alt="NMN Premium 21600 (60 viên)" />
                </div>
            </a>
            <h3>NMN Premium 21600 (60 viên)</h3>
            <p class="price">5.785.000đ</p>
            <button class="btn-buy">Chọn mua</button>
        </div>
    </div>
</section>

