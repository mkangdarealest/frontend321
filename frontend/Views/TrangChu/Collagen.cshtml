
@{
    ViewBag.Title = "Collagen";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    var productName = "Viên uống Collagen With Vitamin C Nature's Bounty";
    var brand = "Nature's Bounty";
    var price = 500000;
    var originalPrice = 550000;
    var rating = 4.9;
    var reviews = 246;
    var description = "Collagen With Vitamin C Nature's Bounty giúp bổ sung collagen, làm đầy lớp biểu bì, chống oxy hóa, tăng sức đề kháng và cải thiện dấu hiệu lão hóa da.";
    var ingredients = "Collagen thủy phân, Vitamin C, L-Ornithine";
    var usage = "Uống 1 viên mỗi ngày sau bữa ăn hoặc theo chỉ dẫn của chuyên gia y tế.";
    var origin = "Hoa Kỳ";
    var packaging = "Lọ 90 viên dùng trong 3 tháng";
}


<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@productName</title>
    <link rel="stylesheet" href="~/css/SanPham/detailed_product.css" />
</head>
<body>
    <div class="product-container">
        <div class="product-image">
            <img src="/hinh/Collagen.jpg" alt="@productName" />
        </div>
        <div class="product-info">
            <h1>@productName</h1>
            <p class="brand">Thương hiệu: <strong>@brand</strong></p>
            <div class="price">
                <span class="current">@price.ToString("N0")₫</span>
                <span class="original">@originalPrice.ToString("N0")₫</span>
            </div>
            <div class="rating">
                ⭐ @rating / 5.0 - @reviews đánh giá
            </div>
            <p class="description">@description</p>

            <table class="details">
                <tr><td><strong>Thành phần:</strong></td><td>@ingredients</td></tr>
                <tr><td><strong>Cách dùng:</strong></td><td>@usage</td></tr>
                <tr><td><strong>Xuất xứ:</strong></td><td>@origin</td></tr>
                <tr><td><strong>Quy cách:</strong></td><td>@packaging</td></tr>
            </table>

            <button class="buy-button">Mua ngay</button>
        </div>
    </div>
</body>
</html>
