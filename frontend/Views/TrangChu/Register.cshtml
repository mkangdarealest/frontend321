@model frontend.Models.Customer
@{
    ViewBag.Title = "Đăng ký tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/css/register.css" rel="stylesheet" type="text/css" />

<div class="register-container" style="padding-top: 65px; padding-bottom: 20px;">
    @using (Html.BeginForm("Register", "TrangChu", FormMethod.Post, new { @class = "register-form" }))
    {
        @Html.AntiForgeryToken()

        <h2>@ViewBag.Title</h2>

        @Html.ValidationSummary("", new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(m => m.UserName, "Tên đăng nhập *")
            @Html.TextBoxFor(m => m.UserName, new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Password, "Mật khẩu *")
            @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
        </div>

        <div class="form-row">
            <div class="form-group">
                @Html.LabelFor(m => m.FirstName, "Họ")
                @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.LastName, "Tên *")
                @Html.TextBoxFor(m => m.LastName, new { @class = "form-control" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Email, "Email *")
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Phone, "Số điện thoại")
            @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.AddressLine, "Địa chỉ")
            @Html.TextBoxFor(m => m.AddressLine, new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.City, "Thành phố")
            @Html.TextBoxFor(m => m.City, new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.District, "Quận/Huyện")
            @Html.TextBoxFor(m => m.District, new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.PostalCode, "Mã bưu điện")
            @Html.TextBoxFor(m => m.PostalCode, new { @class = "form-control" })
        </div>


        <div class="form-group">
            <button type="submit" class="btn btn-primary">
                Tạo tài khoản
            </button>
        </div>

        <div class="form-footer">
            <p>
                Đã có tài khoản?
                @Html.ActionLink("Đăng nhập ngay", "Login")
            </p>
        </div>
    }
</div>