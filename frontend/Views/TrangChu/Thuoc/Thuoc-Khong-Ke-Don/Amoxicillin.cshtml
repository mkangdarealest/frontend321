
@{
    ViewBag.Title = "Amoxicillin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@{
    var productName = "Viên nang Amoxicillin 500mg Domesco";
    var brand = "Domesco";
    var price = 35000;
    var originalPrice = 50000;
    var rating = 4.8;
    var reviews = 78;
    var description = "Amoxicillin 500mg Domesco là thuốc kháng sinh nhóm Penicillin, dùng để điều trị các bệnh nhiễm khuẩn như viêm đường hô hấp, viêm tai giữa, nhiễm khuẩn tiết niệu, da, mô mềm và đường mật.";
    var ingredients = "Amoxicillin trihydrat 500mg";
    var usage = "Uống 1 viên/lần, 2–3 lần mỗi ngày theo chỉ định của bác sĩ.";
    var origin = "Việt Nam";
    var packaging = "Hộp 10 vỉ x 10 viên dùng trong 10–15 ngày";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@productName</title>
    <link rel="stylesheet" href="~/css/SanPham/detailed_product.css" />
</head>
<body>
    <div class="product-container">
        <div class="product-image">
            <img src="/hinh/Amoxicillin-500mg.png" alt="@productName" />
        </div>
        <div class="product-info">
            <h1>@productName</h1>
            <p class="brand">Thương hiệu: <strong>@brand</strong></p>
            <div class="price">
                <span class="current">@price.ToString("N0")₫</span>
                <span class="original">@originalPrice.ToString("N0")₫</span>
            </div>
            <div class="rating">
                ⭐ @rating / 5.0 - @reviews đánh giá
            </div>
            <p class="description">@description</p>

            <table class="details">
                <tr><td><strong>Thành phần:</strong></td><td>@ingredients</td></tr>
                <tr><td><strong>Cách dùng:</strong></td><td>@usage</td></tr>
                <tr><td><strong>Xuất xứ:</strong></td><td>@origin</td></tr>
                <tr><td><strong>Quy cách:</strong></td><td>@packaging</td></tr>
            </table>

            <button class="buy-button">Mua ngay</button>
        </div>
    </div>
</body>
</html>

