
@{
    ViewBag.Title = "Magnesium";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    Layout = null;
    var productName = "Viên uống Magnesium 500mg Nature's Bounty";
    var brand = "Nature's Bounty";
    var price = 523000;
    var originalPrice = 654000;
    var rating = 4.8;
    var reviews = 10537;
    var description = "Magnesium 500mg Nature's Bounty giúp bổ sung magie cho cơ thể, hỗ trợ hệ thần kinh, cơ bắp và tim mạch, giảm căng thẳng và mệt mỏi.";
    var ingredients = "Magnesium Oxide (500mg)";
    var usage = "Uống 1 viên mỗi ngày sau bữa ăn hoặc theo chỉ dẫn của chuyên gia y tế.";
    var origin = "Mỹ";
    var packaging = "Lọ 100 viên dùng trong hơn 3 tháng";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@productName</title>
    <link rel="stylesheet" href="~/css/SanPham/detailed_product.css" />
</head>
<body>
    <div class="product-container">
        <div class="product-image">
            <img src="/hinh/Magnesium.jpg" alt="@productName" />
        </div>
        <div class="product-info">
            <h1>@productName</h1>
            <p class="brand">Thương hiệu: <strong>@brand</strong></p>
            <div class="price">
                <span class="current">@price.ToString("N0")₫</span>
                <span class="original">@originalPrice.ToString("N0")₫</span>
            </div>
            <div class="rating">
                ⭐ @rating / 5.0 - @reviews đánh giá
            </div>
            <p class="description">@description</p>

            <table class="details">
                <tr><td><strong>Thành phần:</strong></td><td>@ingredients</td></tr>
                <tr><td><strong>Cách dùng:</strong></td><td>@usage</td></tr>
                <tr><td><strong>Xuất xứ:</strong></td><td>@origin</td></tr>
                <tr><td><strong>Quy cách:</strong></td><td>@packaging</td></tr>
            </table>

            <button class="buy-button">Mua ngay</button>
        </div>
    </div>
</body>
</html>
