@model frontend.Models.Admin

@{
    ViewBag.Title = "Xóa Admin";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<style>
    h2 {
        padding-top: 120px;
        padding-bottom: 20px;
    }
</style>
<h2>@ViewBag.Title</h2>

<h3>Bạn có chắc muốn xóa tài khoản này?</h3>
<div>
    <hr />
    <dl class="dl-horizontal">
        <dt>@Html.DisplayNameFor(model => model.Username)</dt>
        <dd>@Html.DisplayFor(model => model.Username)</dd>

        <dt>@Html.DisplayNameFor(model => model.Role)</dt>
        <dd>@Html.DisplayFor(model => model.Role)</dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Xóa" class="btn btn-danger" /> |
            @Html.ActionLink("Quay lại danh sách", "Index")
        </div>
    }
</div>