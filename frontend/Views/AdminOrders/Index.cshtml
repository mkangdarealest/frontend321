@model IEnumerable<frontend.Models.Order>
@{
    ViewBag.Title = "Quản lý Đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Use the Admin layout
}
<style>
    h2 {
        padding-top: 120px;
        padding-bottom: 20px;
    }
</style>
<h2>@ViewBag.Title</h2>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Mã ĐH</th>
            <th>Ngày đặt</th>
            <th>Khách hàng</th>
            <th>Trạng thái</th>
            <th style="text-align:right;">Tổng tiền</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>#@order.Id</td>
                <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@order.Customer.UserName</td>
                <td>@order.OrderStatu.Name</td>
                <td style="text-align:right;">@order.Total.ToString("N0") đ</td>
                <td>
                    @Html.ActionLink("Sửa trạng thái", "Edit", new { id = order.Id }, new { @class = "btn btn-warning btn-sm" })
                    @Html.ActionLink("Xem chi tiết", "Details", new { id = order.Id }, new { @class = "btn btn-info btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>