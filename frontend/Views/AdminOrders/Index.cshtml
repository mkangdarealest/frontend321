@model IEnumerable<frontend.Models.Order>

@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Quản lý đơn hàng</h2>
</div>

<div class="card mb-4">
    <div class="card-body py-3">
        @using (Html.BeginForm("Index", "AdminOrders", FormMethod.Get, new { @class = "form-inline" }))
        {
            <div class="form-group mr-3">
                <label class="mr-2 font-weight-bold">Lọc theo trạng thái:</label>
                <select name="statusId" class="form-control" onchange="this.form.submit()">
                    <option value="">-- Tất cả --</option>
                    @if (ViewBag.StatusList != null)
                    {
                        foreach (var status in ViewBag.StatusList as List<frontend.Models.OrderStatu>)
                        {
                            <option value="@status.Id" @(ViewBag.CurrentStatus == status.Id ? "selected" : "")>
                                @status.Name
                            </option>
                        }
                    }
                </select>
            </div>

            if (ViewBag.CurrentStatus != null)
            {
                <a href="@Url.Action("Index", "AdminOrders")" class="btn btn-outline-secondary btn-sm ml-2">
                    <i class="fas fa-sync"></i> Xóa lọc
                </a>
            }
        }
    </div>
</div>

<table class="table table-striped table-bordered bg-white">
    <thead class="thead-dark">
        <tr>
            <th>Mã ĐH</th>
            <th>Khách hàng</th>
            <th>Ngày đặt</th>
            <th>Tổng tiền</th>
            <th>Trạng thái</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>#@item.Id</td>
                <td>
                    <strong>@item.Customer.LastName @item.Customer.FirstName</strong><br />
                    <small class="text-muted">@item.Customer.Phone</small>
                </td>
                <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td class="font-weight-bold text-primary">@item.Total.ToString("N0") đ</td>
                <td>
                    @if (item.StatusId == 1)
                    {<span class="badge badge-warning" style="color:orange">Chờ xử lý</span> }
                    else if (item.StatusId == 2)
                    { <span class="badge badge-info"style="color:yellow">Đang xử lý</span> }
                    else if (item.StatusId == 3)
                    { <span class="badge badge-success"style="color:green">Hoàn thành</span> }
                    else
                    { <span class="badge badge-danger"style="color:red">Đã hủy</span>}
                </td>
                <td>
                    @Html.ActionLink("Chi tiết", "Details", new { id = item.Id }, new { @class = "btn btn-info btn-sm" })
                    @Html.ActionLink("Cập nhật", "Edit", new { id = item.Id }, new { @class = "btn btn-primary btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>