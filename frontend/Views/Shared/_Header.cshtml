@* Views/Shared/_Header.cshtml *@
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
@*//temp*@
<style>
    .user-dropdown {
        position: relative;
        display: inline-block;
    }

    .user-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        cursor: pointer;
        object-fit: cover;
        border: 2px solid #ddd;
    }

    .user-dropdown-content {
        display: none;
        position: absolute;
        background-color: #f9f9f9;
        min-width: 200px;
        box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
        z-index: 100;
        right: 0;
        border-radius: 5px;
        overflow: hidden;
    }

        .user-dropdown-content a,
        .user-dropdown-content .logout-form button {
            color: black;
            padding: 12px 16px;
            text-decoration: none;
            display: block;
            background: none;
            border: none;
            width: 100%;
            text-align: left;
            font-size: 14px;
        }

            .user-dropdown-content a:hover,
            .user-dropdown-content .logout-form button:hover {
                background-color: #f1f1f1;
            }

    .user-dropdown:hover .user-dropdown-content {
        display: block;
    }

</style>
    <link href="~/css/LongChauClone.css" rel="stylesheet" type="text/css" >

    <header id="lc-header">
        <div class="lc-header-top container">
            <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Mở menu">
                <span></span>
                <span></span>
                <span></span>
            </button>
            <div class="lc-logo">
                <a href="@Url.Action("LongChauClone", "TrangChu")">
                    <img src="~/hinh/logo_default_web_78584a5cc6.png" alt="Long Châu" />
                </a>
            </div>
            <div class="lc-search">
                <form method="get" action="@Url.Action("AllProducts", "TrangChu")" style="display:flex; width:100%;">

                    <input type="text" name="searchString"
                           value="@Request.QueryString["searchString"]"
                           placeholder="Tìm thuốc, thực phẩm chức năng, bệnh lý, bác sĩ..." />

                    <button type="submit"><span>🔍</span></button>
                </form>
            </div>
            <div class="lc-user">
                @if (User.IsInRole("Admin"))
                {
                    <div class="admin-nav" style="padding: 5px; margin-top: 5px;">
                        <strong>Admin:</strong>
                        @Html.ActionLink("Manage Products", "Index", "Products") |
                        @Html.ActionLink("Manage Categories", "Index", "Categories") |
                        @Html.ActionLink("Manage Customers", "Index", "AdminCustomers") |
                        @Html.ActionLink("Manage Orders", "Index", "AdminOrders") |
                        @Html.ActionLink("Manage Stock", "Index", "AdminStock") |
                        @Html.ActionLink("Manage Other Admins", "Index", "AdminUsers") |
                    </div>
                }
                @if (User.Identity.IsAuthenticated)
                {
                    var avatarUrl = Session["UserAvatar"] as string ?? "~/hinh/999.jpg";

                    <div class="user-dropdown">
                        <img src="@Url.Content(avatarUrl)" alt="Avatar" class="user-avatar" />
                        <div class="user-dropdown-content">
                            <div style="padding: 10px; border-bottom: 1px solid #ddd; background-color: #eee;">
                                <strong>@User.Identity.Name</strong>
                            </div>
                            @Html.ActionLink("Hồ sơ khách hàng", "Index", "Customer")
                            @Html.ActionLink("Lịch sử giao dịch", "OrderHistory", "Customer")
                            @using (Html.BeginForm("Logout", "TrangChu", FormMethod.Post, new { id = "logoutForm", @class = "logout-form", style = "color:#000000" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit">Đăng xuất</button>
                            }
                        </div>
                    </div>
                }

                else
                {
                    @Html.ActionLink("Đăng nhập", "Login", "TrangChu")
                    @Html.ActionLink("Đăng ký", "Register", "TrangChu")
                }
            </div>
            <div class="lc-cart">
                🛒 @Html.Action("CartSummary", "GioHang")
            </div>
        </div>
        @{ Html.RenderAction("CategoryNavigation", "TrangChu"); }
    </header>
