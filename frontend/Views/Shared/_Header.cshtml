@* Views/Shared/_Header.cshtml *@
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<link href="~/css/LongChauClone.css" rel="stylesheet" type="text/css" />
<header id="lc-header">
    <div class="lc-header-top container">
        <div class="lc-logo">
            <a href="@Url.Action("LongChauClone", "TrangChu")">
                <img src="https://cdn.nhathuoclongchau.com.vn/unsafe/https://cms-prod.s3-sgn09.fptcloud.com/smalls/logo_default_web_78584a5cc6.png" alt="Long Châu" />
            </a>
        </div>
        <div class="lc-search">
            @{
    var currentQuery = "";
    try
    {
        var httpReq = ViewContext?.HttpContext?.Request;
        if (httpReq?.QueryString != null)
        {
            currentQuery = httpReq.QueryString["q"] ?? "";
        }
    }
    catch
    {
        currentQuery = "";
    }
            }
            <form method="get" action="@Url.Action("Index","Search")" style="display:flex; width:100%;">
                <input type="text" name="q" placeholder="Tìm thuốc, thực phẩm chức năng, bệnh lý, bác sĩ..." value="@currentQuery" />
                <button type="submit"><span>🔍</span></button>
            </form>
        </div>
        <div class="lc-user">
            <a href="/TrangChu/Login" class="lc-login">Đăng nhập</a>
            <span>|</span>
            <a href="/TrangChu/Register" class="lc-register">Đăng ký</a>
        </div>
        <div class="lc-cart">
            <a href="/TrangChu/GioHang" id="cart-icon">
                <i class="fas fa-shopping-cart"></i>
                Giỏ hàng
                <span>(
                <span id="cart-count">0</span>
                )</span>
            </a>
        </div>
    </div>
    <nav class="lc-nav">
        <ul>
            <li><a href="/TrangChu/LongChauClone">Trang chủ</a></li>
            <li><a href="/TrangChu/Thuoc">Thuốc</a></li>

