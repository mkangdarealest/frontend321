<style>
    .user-dropdown {
        position: relative;
        display: inline-block;
    }

    .user-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        cursor: pointer;
        object-fit: cover;
        border: 2px solid #ddd;
    }

    .user-dropdown-content {
