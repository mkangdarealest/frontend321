@* Views/Shared/_Header.cshtml *@
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<link href="~/css/LongChauClone.css" rel="stylesheet" type="text/css" />
<header id="lc-header">
    <div class="lc-header-top container">
        <div class="lc-logo">
            <a href="@Url.Action("LongChauClone", "TrangChu")">
                <img src="https://cdn.nhathuoclongchau.com.vn/unsafe/https://cms-prod.s3-sgn09.fptcloud.com/smalls/logo_default_web_78584a5cc6.png" alt="Long Châu" />
            </a>
        </div>
        <div class="lc-search">
            <input type="text" placeholder="Tìm thuốc, thực phẩm chức năng, bệnh lý, bác sĩ..." />
            <button><span>🔍</span></button>
        </div>
        <div class="lc-user">
            <a href="https://localhost:44333/TrangChu/Login" class="lc-login">Đăng nhập</a>
            <span>|</span>
            <a href="https://localhost:44333/TrangChu/Register" class="lc-register">Đăng ký</a>
        </div>
        <div class="lc-cart">
            <a href="https://localhost:44333/TrangChu/GioHang" id="cart-icon">
                <i class="fas fa-shopping-cart"></i>
                Giỏ hàng
                <span>(
                <span id="cart-count">0</span>
                )</span>
            </a>
        </div>
    </div>
    <nav class="lc-nav">
        <ul>
            <li><a href="https://localhost:44333/TrangChu/LongChauClone">Trang chủ</a></li>
            <li><a href="https://localhost:44333/TrangChu/Thuoc">Thuốc</a></li>
            <li><a href="#">Thiết bị y tế</a></li>
            <li><a href="#">Tiêm Chủng</a></li>
            <li><a href="#">Bệnh lý</a></li>
            <li><a href="#">Góc sức khỏe</a></li>
            <li><a href="#">Hệ thống nhà thuốc</a></li>
        </ul>
    </nav>
</header>