                        </div>
                        @Html.ActionLink("Hồ sơ khách hàng", "Index", "Customer")
                        @Html.ActionLink("Lịch sử giao dịch", "OrderHistory", "Customer")
                        @using (Html.BeginForm("Logout", "TrangChu", FormMethod.Post, new { id = "logoutForm", @class = "logout-form", style = "color:#000000" }))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit">Đăng xuất</button>
                        }
                    </div>
                </div>
            }

            else
