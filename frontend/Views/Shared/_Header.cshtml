@* Views/Shared/_Header.cshtml *@
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<link href="~/css/LongChauClone.css" rel="stylesheet" type="text/css" />
<header id="lc-header">
