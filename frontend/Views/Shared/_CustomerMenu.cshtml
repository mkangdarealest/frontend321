@{
    var currentAction = ViewContext.RouteData.Values["action"].ToString();
    var userAvatar = Session["UserAvatar"] as string ?? "~/hinh/999.jpg";
    var username = User.Identity.Name;
}

<div class="customer-sidebar shadow-sm" style="background: #fff; border-radius: 8px; overflow: hidden; border: 1px solid #eee;">
    <div class="user-info text-center" style="padding: 20px; border-bottom: 1px solid #eee; background-color: #f9f9f9;">
        <div class="avatar-wrapper" style="margin-bottom: 10px;">
            <img src="@Url.Content(userAvatar)" alt="Avatar" style="width: 80px; height: 80px; border-radius: 50%; object-fit: cover; border: 3px solid #fff; box-shadow: 0 2px 5px rgba(0,0,0,0.1);" />
        </div>
        <h5 style="font-weight: 700; margin: 0; color: #333;">@username</h5>
        <span style="font-size: 0.85rem; color: #777;">Thành viên thân thiết</span>
    </div>

    <div class="list-group list-group-flush">
        <a href="@Url.Action("Index", "Customer")"
           class="list-group-item list-group-item-action @(currentAction == "Index" ? "active-menu" : "")"
           style="padding: 15px 20px; font-weight: 500; color: #555; border-left: 4px solid transparent;">
            <i class="fas fa-user-circle" style="width: 25px; color: #00529b;"></i> Hồ sơ cá nhân
        </a>

        <a href="@Url.Action("OrderHistory", "Customer")"
           class="list-group-item list-group-item-action @(currentAction == "OrderHistory" ? "active-menu" : "")"
           style="padding: 15px 20px; font-weight: 500; color: #555; border-left: 4px solid transparent;">
            <i class="fas fa-shopping-bag" style="width: 25px; color: #d0021b;"></i> Lịch sử đơn hàng
        </a>

        <div class="list-group-item" style="padding: 0;">
            @using (Html.BeginForm("Logout", "TrangChu", FormMethod.Post, new { id = "sidebarLogoutForm" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-link btn-block text-left" style="width: 100%; padding: 15px 20px; color: #555; text-decoration: none; font-weight: 500;">
                    <i class="fas fa-sign-out-alt" style="width: 25px; color: #666;"></i> Đăng xuất
                </button>
            }
        </div>
    </div>
</div>

<style>
    .active-menu {
        background-color: #eef5ff !important;
        color: #00529b !important;
        border-left-color: #00529b !important;
        font-weight: 700 !important;
    }

    .list-group-item:hover {
        background-color: #f8f9fa;
        color: #00529b;
    }
</style>