@model frontend.Models.AdminStockViewModel
@{
    ViewBag.Title = "Quản Lý Kho Hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<style>
    h2 {
        padding-top: 120px;
        padding-bottom: 20px;
    }
</style>
<h2>@ViewBag.Title</h2>

<hr />

<h4>
    <span class="badge badge-success" style="background-color: #28a745;">
        Hàng Tồn
    </span>
</h4>
<p>Tổng cộng có @Model.InStockProducts.Count() sản phẩm còn hàng.</p>
<table class="table table-bordered table-striped table-hover">
    <thead class="thead-dark">
        <tr>
            <th style="width: 100px;">Ảnh</th>
            <th>Tên Sản Phẩm</th>
            <th>Thương Hiệu</th>
            <th style="width: 100px;">Số Lượng</th>
            <th style="width: 100px;"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.InStockProducts)
        {
            <tr>
                <td>
                    @{
                        string imageUrl = item.ProductImages.FirstOrDefault()?.Url;

                        // 2. If it's empty, use your 'R.png' placeholder
                        if (string.IsNullOrEmpty(imageUrl))
                        {
                            imageUrl = "~/hinh/R.png"; //
                        }
                    }

                    <img src="@Url.Content(imageUrl)"
                         alt="@item.Name"
                         style="width: 100%; height: auto; object-fit: cover;" />
                </td>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Brand)</td>
                <td>
                    <span class="badge badge-success" style="background-color: #28a745; font-size: 14px;">
                        @Html.DisplayFor(modelItem => item.Quantity)
                    </span>
                </td>
                <td>
                    @Html.ActionLink("Sửa", "Edit", "Products", new { id = item.Id }, new { @class = "btn btn-primary" })
                </td>
            </tr>
        }
    </tbody>
</table>

<hr style="margin-top: 40px; margin-bottom: 20px;" />

<h4>
    <span class="badge badge-danger" style="background-color: #dc3545;">
        Hàng Cần Nhập
    </span>
</h4>
<p>Tổng cộng có @Model.OutOfStockProducts.Count() sản phẩm đã hết hàng.</p>
<table class="table table-bordered table-striped table-hover">
    <thead class="thead-dark">
        <tr>
            <th style="width: 100px;">Ảnh</th>
            <th>Tên Sản Phẩm</th>
            <th>Thương Hiệu</th>
            <th style="width: 100px;">Số Lượng</th>
            <th style="width: 100px;"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OutOfStockProducts)
        {
            <tr>
                <td>
                    @{
                        // 1. Get the URL
                        string imageUrl = item.ProductImages.FirstOrDefault()?.Url;

                        // 2. If it's empty, use your 'R.png' placeholder
                        if (string.IsNullOrEmpty(imageUrl))
                        {
                            imageUrl = "~/hinh/R.png"; //
                        }
                    }

                    <img src="@Url.Content(imageUrl)"
                         alt="@item.Name"
                         style="width: 100%; height: auto; object-fit: cover; filter: grayscale(100%);" />
                </td>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Brand)</td>
                <td>
                    <span class="badge badge-danger" style="background-color: #dc3545; font-size: 14px;">
                        @Html.DisplayFor(modelItem => item.Quantity)
                    </span>
                </td>
                <td>
                    @Html.ActionLink("Sửa", "Edit", "Products", new { id = item.Id }, new { @class = "btn btn-primary" })
                </td>
            </tr>
        }
    </tbody>
</table>