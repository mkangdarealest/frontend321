@model IEnumerable<frontend.Models.Product>

@{
    ViewBag.Title = "Kết quả tìm kiếm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="padding-top: 65px; padding-bottom: 20px;">
    <h2>Kết quả tìm kiếm cho "@ViewBag.CurrentQuery"</h2>
    <hr />

    @if (!Model.Any())
    {
        <p>Không tìm thấy sản phẩm nào phù hợp.</p>
    }
    else
    {
        @* We can re-use your existing CSS classes from LongChauClone.css *@
        <div class="lc-product-list_all">

            @foreach (var product in Model)
            {
                // --- Image Logic (same as your homepage) ---
                var image = product.ProductImages.FirstOrDefault(img => img.IsPrimary) ?? product.ProductImages.FirstOrDefault();
                string imageUrl = (image != null) ? image.Url : "~/hinh/VitaminC.jpg"; // Placeholder

                <div class="lc-product-card">

                    @* This link points to the product's detail page *@
                    <a href="@Url.Action("ViewProduct", "TrangChu", new { slug = product.Slug })">
                        <div class="lc-product-image-container">
                            <img src="@Url.Content(imageUrl)" alt="@product.Name" />
                        </div>
                    </a>

                    <h3>@product.Name</h3>
                    <p class="price">@(product.Price.HasValue ? product.Price.Value.ToString("N0") + "đ" : "")</p>
                    <button class="btn-buy">Chọn mua</button>
                </div>
            }
        </div>
    }
</div>