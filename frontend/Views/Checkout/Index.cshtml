@model frontend.Models.CheckoutViewModel
@{
    ViewBag.Title = "Thanh toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/css/GioHang.css" rel="stylesheet" />

<div class="container_1">
    <h1>@ViewBag.Title</h1>

    @if (TempData["Error"] != null)
    {
        <div style="background-color: #ffebe6; border: 1px solid #e43f3f; padding: 15px; border-radius: 8px; margin-bottom: 20px; color: #b71c1c;">
            @TempData["Error"]
        </div>
    }

    <div class="cart-layout">

        <div class="cart-items">
            <h3>Thông tin giao hàng</h3>
            <hr />
            <p>
                <strong>Họ tên:</strong>
                @Model.CustomerDetails.FirstName @Model.CustomerDetails.LastName
            </p>
            <p>
                <strong>Email:</strong>
                @Model.CustomerDetails.Email
            </p>
            <p>
                <strong>Số điện thoại:</strong>
                @Model.CustomerDetails.Phone
            </p>
            <p>
                <strong>Địa chỉ:</strong>
                @Model.CustomerDetails.AddressLine
            </p>
            <br />
            @Html.ActionLink("Chỉnh sửa thông tin", "Index", "Customer", null, new { @class = "btn btn-info" })
        </div>

        <aside class="cart-summary">
            <h2>Đơn hàng của bạn</h2>

            @foreach (var item in Model.CartItems)
            {
                <div class="cart-product" style="background-color: #fff;">
                    <img src="@Url.Content(item.ProductImage ?? "/hinh/default-product.png")" alt="@item.ProductName" class="cart-product-img" />
                    <div class="cart-product-name">
                        @item.ProductName
                        <div style="color: #888; font-size: 0.9em;">SL: @item.Quantity</div>
                    </div>
                    <div class="cart-product-price" style="min-width: 80px;">
                        @item.LineTotal.ToString("N0") đ
                    </div>
                </div>
            }

            <hr />

            <div class="summary-line">
                <span>Tạm tính</span>
                <span>@Model.SubTotal.ToString("N0") đ</span>
            </div>

            @if (Model.DiscountAmount > 0)
            {
                <div class="summary-line" style="color: #00b33c;">
                    <span>Giảm giá</span>
                    <span>-@Model.DiscountAmount.ToString("N0") đ</span>
                </div>
            }

            <div class="summary-line total">
                <span>Thành tiền</span>
                <span>@Model.TotalAmount.ToString("N0") đ</span>
            </div>

            @using (Html.BeginForm("PlaceOrder", "Checkout", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <p style="margin-top: 15px;">Phương thức thanh toán: <strong>Thanh toán khi nhận hàng (COD)</strong></p>
                <button type="submit" class="checkout-btn">Hoàn tất đặt hàng</button>
            }
        </aside>
    </div>
</div>