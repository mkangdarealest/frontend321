@model IEnumerable<frontend.Models.Customer>
@{
    ViewBag.Title = "Quản lý Khách hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    h2 {
        padding-top: 120px;
        padding-bottom: 20px;
    }
</style>
<h2>@ViewBag.Title</h2>
<p>Danh sách tất cả khách hàng đã đăng ký.</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Họ tên</th>
            <th>Email</th>
            <th>Số điện thoại</th>
            <th>Ngày tham gia</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FirstName @item.LastName</td>
                <td>@item.Email</td>
                <td>@item.Phone</td>
                <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                <td>
                    @Html.ActionLink("Xem chi tiết", "Details", new { id = item.Id }, new { @class = "btn btn-info btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>