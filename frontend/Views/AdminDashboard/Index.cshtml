@{
    ViewBag.Title = "Tổng quan hệ thống";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="dashboard-header mb-4">
    <h2 class="font-weight-bold text-dark">
        <i class="fas fa-rocket text-primary"></i> Dashboard
    </h2>
    <p class="text-muted">Chào mừng trở lại, quản trị viên!</p>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary mb-3 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-uppercase mb-1" style="opacity:0.8;">Doanh thu</h6>
                        <h3 class="mb-0 font-weight-bold">@(((decimal)ViewBag.TotalRevenue).ToString("N0")) đ</h3>
                    </div>
                    <i class="fas fa-coins fa-2x" style="opacity:0.5;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-success mb-3 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-uppercase mb-1" style="opacity:0.8;">Đơn hàng</h6>
                        <h3 class="mb-0 font-weight-bold">@ViewBag.TotalOrders</h3>
                        <small>@ViewBag.PendingOrders chờ xử lý</small>
                    </div>
                    <i class="fas fa-shopping-cart fa-2x" style="opacity:0.5;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-info mb-3 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-uppercase mb-1" style="opacity:0.8;">Khách hàng</h6>
                        <h3 class="mb-0 font-weight-bold">@ViewBag.TotalCustomers</h3>
                    </div>
                    <i class="fas fa-users fa-2x" style="opacity:0.5;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-danger mb-3 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-uppercase mb-1" style="opacity:0.8;">Cảnh báo kho</h6>
                        <h3 class="mb-0 font-weight-bold">@ViewBag.LowStockCount</h3>
                        <small>Sản phẩm sắp hết</small>
                    </div>
                    <i class="fas fa-exclamation-triangle fa-2x" style="opacity:0.5;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white font-weight-bold">
                <i class="fas fa-server text-secondary"></i> Trạng thái hệ thống (Database Status)
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-borderless mb-0">
                        <tr>
                            <td width="150" class="text-muted">Database Name:</td>
                            <td class="font-weight-bold">@ViewBag.DbName</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Server:</td>
                            <td><code>@ViewBag.DbServer</code></td>
                        </tr>
                        <tr>
                            <td class="text-muted">Status:</td>
                            <td>
                                <span class="badge badge-pill badge-success px-3 py-2">
                                    <i class="fas fa-check-circle"></i> @ViewBag.DbStatus
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted">Last Checked:</td>
                            <td>@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header bg-white font-weight-bold">
                <i class="fas fa-bolt text-warning"></i> Thao tác nhanh
            </div>
            <div class="list-group list-group-flush">
                <a href="@Url.Action("Create", "Products")" class="list-group-item list-group-item-action">
                    <i class="fas fa-plus-circle text-success mr-2"></i> Thêm sản phẩm mới
                </a>
                <a href="@Url.Action("Index", "AdminOrders", new { statusId = 1 })" class="list-group-item list-group-item-action">
                    <i class="fas fa-clock text-warning mr-2"></i> Xem đơn chờ xử lý
                </a>
                <a href="@Url.Action("Index", "AdminUsers")" class="list-group-item list-group-item-action">
                    <i class="fas fa-user-shield text-dark mr-2"></i> Quản lý Admin
                </a>
            </div>
        </div>
    </div>
</div>

<div id="easter-egg-modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.8); z-index:9999; align-items:center; justify-content:center; text-align:center; color:white;">
    <div>
        <h1 style="font-size: 5rem; color: #00ff00; font-family: monospace;">HACKER MODE ACTIVATED</h1>
        <p>Bạn đã tìm thấy bí mật của Long Châu Admin!</p>
        <img src="https://media.giphy.com/media/YQitE4YNQNahy/giphy.gif" alt="Hacker Cat" style="border-radius:10px; margin-top:20px;">
        <br /><br />
        <button class="btn btn-outline-light" onclick="location.reload()">CLOSE</button>
    </div>
</div>

@section Scripts {
    <script>
        // --- THE EASTER EGG (KONAMI CODE) ---
        // Code: Up, Up, Down, Down, Left, Right, Left, Right, B, A
        const konamiCode = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
        let cursor = 0;

        document.addEventListener('keydown', (e) => {
            // Check if the key matches the current position in the code
            if (e.key.toLowerCase() === konamiCode[cursor].toLowerCase() || e.key === konamiCode[cursor]) {
                cursor++;

                // If the sequence is complete
                if (cursor === konamiCode.length) {
                    activateEasterEgg();
                    cursor = 0; // Reset
                }
            } else {
                cursor = 0; // Reset if wrong key
            }
        });

        function activateEasterEgg() {
            // 1. Show the Modal
            document.getElementById('easter-egg-modal').style.display = "flex";

            // 2. Play a sound (optional, browser might block auto-play)
            // var audio = new Audio('https://www.myinstants.com/media/sounds/metal-gear-solid-alert.mp3');
            // audio.play();
        }
    </script>
}